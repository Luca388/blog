---
import Base from '../../layouts/Base.astro';
import { getPosts, groupByCategory, url } from '../../lib/posts';

const categories = groupByCategory(await getPosts());
---

<Base title="카테고리">
	<h1 class="page-title">카테고리</h1>
	<ul class="term-grid">
		{
			categories.map(([key, { label, posts }]) => (
				<li>
					<a href={url(`/categories/${key}/`)}>
						{label} <small>{posts.length}</small>
					</a>
				</li>
			))
		}
	</ul>
</Base>

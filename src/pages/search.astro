---
import Base from '../layouts/Base.astro';
import { url } from '../lib/posts';

// The index is generated by `pagefind` after `astro build`, so search only works on built output.
const baseUrl = url('/');
const bundle = url('/pagefind/');
---

<Base title="검색">
	<h1 class="page-title">검색</h1>
	<link rel="stylesheet" href={`${bundle}pagefind-ui.css`} />
	<div id="search" data-bundle={bundle} data-base-url={baseUrl}></div>
	<script is:inline type="module">
		const el = document.getElementById('search');
		const { bundle, baseUrl } = el.dataset;
		try {
			await import(`${bundle}pagefind-ui.js`);
			new PagefindUI({
				element: '#search',
				// both must be explicit because the site lives under /blog/
				bundlePath: bundle,
				baseUrl,
				showSubResults: true,
				showImages: false,
				translations: { placeholder: '검색어를 입력하세요' },
			});
		} catch {
			el.textContent = '검색 인덱스가 없어요. npm run build 후 npm run preview로 확인하세요.';
		}
	</script>
</Base>

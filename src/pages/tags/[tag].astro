---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, groupByTag, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	return groupByTag(await getPosts()).map(([tag, { label, posts }]) => ({
		params: { tag },
		props: { label, posts },
	}));
}

interface Props {
	label: string;
	posts: Post[];
}

const { label, posts } = Astro.props;
---

<Base title={`#${label}`}>
	<h1 class="page-title">#{label} <small>{posts.length}</small></h1>
	<PostList posts={posts} />
</Base>

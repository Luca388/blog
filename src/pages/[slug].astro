---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import {
	RESERVED_SLUGS,
	categoryKey,
	formatDate,
	getPosts,
	postUrl,
	tagKey,
	url,
	type Post,
} from '../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	// Case-insensitive, since macOS builds write callback/ and CallBack/ to the same folder.
	const seen = new Map<string, string>(RESERVED_SLUGS.map((slug) => [slug, '사이트 기본 페이지']));
	for (const post of posts) {
		const key = post.data.slug.toLowerCase();
		if (seen.has(key)) throw new Error(`${post.filePath}: 주소 /${post.data.slug}/ 가 ${seen.get(key)}와 겹쳐요. 파일명을 바꿔주세요`);
		seen.set(key, post.id);
	}
	return posts.map((post, i) => ({
		params: { slug: post.data.slug },
		// posts are newest first, so the next index is the older post
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
// the leading `# heading` is already shown as the page title
const bodyHeadings = post.data.titleFromBody ? headings.slice(1) : headings;
const toc = bodyHeadings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<Base title={post.data.title}>
	<article class="post">
		<header class="post-header">
			<a class="chip" href={url(`/categories/${categoryKey(post.data.category)}/`)}>
				{post.data.category}
			</a>
			<h1>{post.data.title}</h1>
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
		</header>

		{
			toc.length > 2 && (
				<details class="toc" open>
					<summary>목차</summary>
					<ul>
						{toc.map((h) => (
							<li class={`depth-${h.depth}`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</details>
			)
		}

		<div class:list={['prose', { 'title-from-body': post.data.titleFromBody }]} data-pagefind-body>
			<Content />
		</div>

		{
			post.data.tags.length > 0 && (
				<ul class="tags">
					{post.data.tags.map((tag) => (
						<li>
							<a class="chip" href={url(`/tags/${tagKey(tag)}/`)}>
								#{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}

		<nav class="post-nav">
			{
				older ? (
					<a href={postUrl(older)}>
						<span>이전 글</span>
						{older.data.title}
					</a>
				) : (
					<span />
				)
			}
			{
				newer && (
					<a class="next" href={postUrl(newer)}>
						<span>다음 글</span>
						{newer.data.title}
					</a>
				)
			}
		</nav>
	</article>
</Base>

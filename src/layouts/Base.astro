---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { ADSENSE_CLIENT, AUTHOR, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { categoryInfo, getPosts, groupCategories, url } from '../lib/posts';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
	{ href: url('/about/'), label: '소개' },
	{ href: url('/posts/'), label: '글' },
	{ href: url('/categories/'), label: '카테고리' },
	{ href: url('/tags/'), label: '태그' },
	{ href: url('/search/'), label: '검색' },
];

const sidebarGroups = groupCategories(await getPosts());
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
		<link rel="sitemap" href={url('/sitemap-index.xml')} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{
			ADSENSE_CLIENT && (
				<>
					<meta name="google-adsense-account" content={ADSENSE_CLIENT} />
					<script
						is:inline
						async
						src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
						crossorigin="anonymous"
					></script>
				</>
			)
		}
		<script is:inline>
			(() => {
				let theme;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				theme ??= matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
				// wide windows only: whether the sidebar column is shown (open unless closed before)
				let sidebar;
				try {
					sidebar = localStorage.getItem('sidebar');
				} catch {}
				document.documentElement.dataset.sidebar = sidebar === 'closed' ? 'closed' : 'open';
			})();
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<div class="header-start">
					<button
						id="sidebar-toggle"
						class="icon-btn"
						type="button"
						aria-controls="sidebar"
						aria-expanded="false"
						aria-label="사이드바 열기/닫기"
					>
						<Icon name="sidebar" size={18} />
					</button>
					<a class="site-title" href={url('/')}>{SITE_TITLE}</a>
				</div>
				<nav>
					{
						nav.map(({ href, label }) => (
							<a
								href={href}
								aria-current={path.startsWith(href) ? 'page' : undefined}
							>
								{label}
							</a>
						))
					}
					<button id="theme-toggle" type="button" aria-label="다크 모드 전환">◐</button>
				</nav>
			</div>
		</header>
		<div class="shell">
			<aside class="sidebar" id="sidebar" aria-label="사이드바">
				<div class="sidebar-inner">
					<button class="icon-btn sb-close" type="button" aria-label="사이드바 닫기" data-sidebar-close>
						<Icon name="x" size={18} />
					</button>
					<a class="sb-profile" href={url('/about/')}>
						<img src={`${GITHUB_URL}.png?size=96`} alt="" width="40" height="40" />
						<div>
							<strong>{AUTHOR}</strong>
							<span>개발 · 보안 기록</span>
						</div>
					</a>
					<ul>
						<li>
							<a href={url('/posts/')} aria-current={path === url('/posts/') ? 'page' : undefined}>
								<Icon name="doc" size={16} /> 전체 글
							</a>
						</li>
						<li>
							<a href={url('/tags/')} aria-current={path.startsWith(url('/tags/')) ? 'page' : undefined}>
								<Icon name="tag" size={16} /> 태그
							</a>
						</li>
					</ul>
					{sidebarGroups.map((group) => (
						<>
							<p class="sb-group">{group.label}</p>
							<ul>
								{group.categories.map(([key, { label, posts }]) => {
									const href = url(`/categories/${key}/`);
									return (
										<li>
											<a
												href={href}
												class:list={{ empty: !posts.length }}
												aria-current={decodeURI(path) === decodeURI(href) ? 'page' : undefined}
											>
												<Icon name={categoryInfo(label).icon} size={16} />
												{label}
												<small>{posts.length}</small>
											</a>
										</li>
									);
								})}
							</ul>
						</>
					))}
				</div>
			</aside>
			<div class="sidebar-backdrop" data-sidebar-close></div>
			<div class="content">
				<main class="container">
					<slot />
				</main>
				<footer class="site-footer container">
					<span>© {new Date().getFullYear()} Luca</span>
					<a href={GITHUB_URL}>GitHub</a>
					<a href={url('/rss.xml')}>RSS</a>
					<a href={url('/privacy/')}>개인정보처리방침</a>
				</footer>
			</div>
		</div>
		<script is:inline>
			document.getElementById('theme-toggle').addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem('theme', next);
				} catch {}
			});

			// Sidebar: a column toggled (and remembered) on wide windows, a drawer on narrow ones.
			(() => {
				const root = document.documentElement;
				const wide = matchMedia('(min-width: 1100px)');
				const toggle = document.getElementById('sidebar-toggle');
				const sync = () =>
					toggle.setAttribute(
						'aria-expanded',
						String(wide.matches ? root.dataset.sidebar !== 'closed' : root.dataset.drawer === 'open'),
					);
				const setDrawer = (open) => {
					if (open) root.dataset.drawer = 'open';
					else delete root.dataset.drawer;
					sync();
				};
				toggle.addEventListener('click', () => {
					if (!wide.matches) return setDrawer(root.dataset.drawer !== 'open');
					root.dataset.sidebar = root.dataset.sidebar === 'closed' ? 'open' : 'closed';
					try {
						localStorage.setItem('sidebar', root.dataset.sidebar);
					} catch {}
					sync();
				});
				document.querySelectorAll('[data-sidebar-close]').forEach((el) => el.addEventListener('click', () => setDrawer(false)));
				document.addEventListener('keydown', (e) => e.key === 'Escape' && setDrawer(false));
				wide.addEventListener('change', () => setDrawer(false));
				sync();
			})();
		</script>
	</body>
</html>

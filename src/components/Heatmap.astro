---
/**
 * GitHub-style grid of the days posts were written, one calendar year at a time.
 * The page holds only this year's empty grid; the script fetches the post days once
 * (src/pages/heatmap.json.ts), colors the days with posts, and redraws the grid for another year.
 */
import { dayKey, url, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

const thisYear = Number(dayKey(new Date()).slice(0, 4));
const years = [...new Set(posts.map((p) => Number(dayKey(p.data.date).slice(0, 4))))]
	.filter((y) => y <= thisYear)
	.sort((a, b) => b - a);
if (!years.includes(thisYear)) years.unshift(thisYear);

// This year's empty grid, so the box has its final size before the script fills it in.
const lead = new Date(Date.UTC(thisYear, 0, 1)).getUTCDay(); // days before Jan 1 in its week
const length = (Date.UTC(thisYear + 1, 0, 1) - Date.UTC(thisYear, 0, 1)) / 864e5;
const weeks = Math.ceil((lead + length) / 7);
---

<section class="heatmap" data-heatmap data-src={url('/heatmap.json')}>
	<div class="heatmap-head">
		<h2 class="section-title">기록</h2>
		<div class="heatmap-years" role="tablist" aria-label="연도">
			{
				years.map((year, i) => (
					<button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-year={year}>
						{year}
					</button>
				))
			}
		</div>
	</div>
	<div class="heatmap-year" style={`--weeks: ${weeks}`}>
		<p class="heatmap-summary">&nbsp;</p>
		<div class="heatmap-scroll">
			<div class="heatmap-months"></div>
			<div class="heatmap-grid" role="img" aria-label="글 쓴 날">
				{Array.from({ length: weeks * 7 }, (_, i) => <i class={i < lead || i >= lead + length ? 'out' : undefined} />)}
			</div>
		</div>
		<div class="heatmap-legend" aria-hidden="true">
			적음 <span class="cell" /><span class="cell l1" /><span class="cell l2" /><span class="cell l3" /><span class="cell l4" /> 많음
		</div>
	</div>
</section>

<script is:inline>
	document.querySelectorAll('[data-heatmap]').forEach((root) => {
		const panel = root.querySelector('.heatmap-year');
		const scroller = panel.querySelector('.heatmap-scroll');
		const months = panel.querySelector('.heatmap-months');
		const grid = panel.querySelector('.heatmap-grid');
		const summary = panel.querySelector('.heatmap-summary');
		const tabs = root.querySelectorAll('button[data-year]');
		// "today" in Korea, worked out on each visit rather than at build time
		const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Seoul' }).format(new Date());
		const DAY = 864e5;
		const level = (n) => (n <= 2 ? n : n <= 4 ? 3 : 4);
		let days; // { 'YYYY-MM-DD': [titles] }, fetched once
		const load = () => (days ??= fetch(root.dataset.src).then((r) => r.json()));

		async function show(year) {
			const posts = await load();
			const start = Date.UTC(year, 0, 1);
			const lead = new Date(start).getUTCDay();
			const length = (Date.UTC(year + 1, 0, 1) - start) / DAY;
			const weeks = Math.ceil((lead + length) / 7);
			const cells = [];
			const labels = [];
			let total = 0;
			let active = 0;
			for (let i = 0; i < weeks * 7; i++) {
				const cell = document.createElement('i');
				cells.push(cell);
				if (i < lead || i >= lead + length) {
					cell.className = 'out';
					continue;
				}
				const key = new Date(start + (i - lead) * DAY).toISOString().slice(0, 10);
				const titles = posts[key] ?? [];
				const classes = [];
				if (titles.length) {
					classes.push(`l${level(titles.length)}`);
					cell.title = `${key} · 글 ${titles.length}개\n${titles.join('\n')}`;
					total += titles.length;
					active++;
				}
				if (key > today) classes.push('future');
				if (key === today) classes.push('today');
				if (classes.length) cell.className = classes.join(' ');
				if (key.endsWith('-01')) {
					const label = document.createElement('span');
					label.textContent = `${Number(key.slice(5, 7))}월`;
					label.style.gridColumn = Math.floor(i / 7) + 1;
					labels.push(label);
				}
			}
			panel.style.setProperty('--weeks', weeks);
			grid.replaceChildren(...cells);
			months.replaceChildren(...labels);
			grid.setAttribute('aria-label', `${year}년 글 ${total}개, 기록한 날 ${active}일`);
			summary.innerHTML = `${year}년에 <strong>${total}개</strong>의 글, <strong>${active}일</strong> 기록했어요`;
			// on narrow screens, start scrolled to today rather than January
			const now = grid.querySelector('.today');
			scroller.scrollLeft = now ? now.offsetLeft - scroller.clientWidth + 48 : scroller.scrollWidth;
		}

		tabs.forEach((tab) =>
			tab.addEventListener('click', () => {
				tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
				show(Number(tab.dataset.year));
			}),
		);
		show(Number(tabs[0].dataset.year));
	});
</script>

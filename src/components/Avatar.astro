---
/**
 * The GitHub profile picture, served from the blog as WebP (1x and 2x) instead of every
 * visitor going through github.com/<user>.png, an uncached and sometimes very slow redirect.
 * The picture is src/assets/avatar.jpg; each deploy first tries to refresh it from GitHub
 * (.github/workflows/deploy.yml) and keeps the saved one if that fails.
 */
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';

interface Props {
	/** Shown size in CSS pixels. */
	size: number;
	class?: string;
}

const { size, class: className } = Astro.props;
---

<Image src={avatar} alt="" width={size} height={size} densities={[1, 2]} loading="eager" class={className} />
